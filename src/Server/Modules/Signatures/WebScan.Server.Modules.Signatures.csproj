<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>WebScan.Server.Modules.Signatures</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\..\Kernel\WebScan.Server.Kernel.csproj" />
    <ProjectReference Include="..\..\Infrastructure\WebScan.Server.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="WolverineFx" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>
  <ItemGroup>
    <!-- Signature packs seeded at startup (Persistence/SignaturePacks.cs); nuclei-safe is generated by scripts/build-nuclei-safe-pack.cs. -->
    <EmbeddedResource Include="Packs\**\pack.json;Packs\**\*.yaml;Packs\**\LICENSE.md" LogicalName="Packs/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="WebScan.Discovery.UnitTests" />
  </ItemGroup>
</Project>
