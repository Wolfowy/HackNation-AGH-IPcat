{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    }
  },
  // TLS to the server: system trust store by default.
  "Server": {
    // PEM/DER file of a private CA that signed the server certificate (pinning; system trust is then not used).
    "CaCertificatePath": null,
    // Accept any server certificate. Refused outside the Development environment.
    "AllowInsecureTls": false
  },
  "Agent": {
    // Base URL of the central server (agents always initiate connections).
    "ServerUrl": "https://localhost:5443",
    // Stable agent id; default = sanitized hostname. Ignored once credentials are stored.
    "AgentId": null,
    // One-time enrollment token (admin-created). Needed only on first start; credentials are then persisted (mode 600).
    "EnrollmentToken": null,
    // SQLite result buffer + credentials. Default: <LocalApplicationData>/webscan-agent.
    "DataDirectory": null,
    // Concurrent jobs (claim slots) and agent-wide packets/requests per second (each job gets MaxRatePerSecond / MaxConcurrentJobs at most).
    "MaxConcurrentJobs": 4,
    "MaxConcurrentJobsPerInterface": null,
    "MaxRatePerSecond": 2000,
    // Raw sockets for the tools (SYN scans, ICMP/ARP discovery): null = detect (root, CAP_NET_RAW, or NMAP_PRIVILEGED set by the
    // container image whose tools carry file capabilities). Agents reporting false never get such jobs.
    "RawSockets": null,
    // Informational zones the agent claims to sit in (the server's assignment is authoritative).
    "DeclaredZones": [],
    // Tool manifests (*.json). Default: <app>/tools.d.
    "ToolManifestPaths": [],
    // Parser/adapter plugin assemblies (files or directories), installed locally by the operator; never downloaded.
    "PluginPaths": [],
    // When non-empty, only plugin DLLs with these SHA-256 hashes (hex) are loaded.
    "TrustedPluginSha256": [],
    // Synthetic "fake" tool for tests/E2E/load tests (never opens sockets). Never enable in production.
    "EnableFakeTools": false,
    // Overrides the heartbeat interval sent by the server.
    "HeartbeatIntervalSeconds": null,
    // Result batching: max observations per batch / max seconds before a partial batch is flushed.
    "ResultBatchMaxObservations": 500,
    "ResultBatchFlushSeconds": 5,
    // Seconds allowed on shutdown to report cancelled jobs and flush buffered results.
    "ShutdownFlushSeconds": 10,
    // Loop backoff start (doubles up to 60 s) while the server is unreachable; quick in-call HTTP retries.
    "ErrorBackoffSeconds": 1,
    "HttpRetryAttempts": 3,
    "HttpRetryBaseDelayMs": 500,
    "HttpTimeoutSeconds": 60,
    // Reported interfaces: exact names to include (empty = all non-loopback) / exclude.
    "Interfaces": { "Include": [], "Exclude": [] },
    // Replace detected interfaces/routes (simulated agents, multi-perspective demos), e.g.
    // "StaticInterfaces": [ { "Name": "lab0", "Addresses": [ "10.10.0.5/24" ] } ],
    // "StaticRoutes": [ { "Destination": "10.20.0.0/16", "Gateway": "10.10.0.1", "InterfaceName": "lab0" } ],
    "StaticInterfaces": [],
    "StaticRoutes": [],
    // Fake tool behaviour (read on every job, so it can change between scans without restart):
    // AliveRatio, DelayPerTargetMs, ExtraOpenPorts { "10.0.0.5": [8081] }, ClosedPorts { "10.0.0.5": [22] },
    // DownHosts [ "10.0.0.7" ], ServiceOverrides [ { "Address": "10.0.0.5", "Port": 8081, "Name": "http", "Product": "nginx", "Version": "1.27" } ].
    "FakeTools": {
      "AliveRatio": 0.6,
      "DelayPerTargetMs": 0
    }
  }
}
