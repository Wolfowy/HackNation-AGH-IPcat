// Synthetic scanner for tests, planner load tests and E2E: deterministic results derived from target addresses,
// never opens sockets. The "fake" adapter is registered only when Agent:EnableFakeTools=true; otherwise this
// manifest is skipped (adapter unavailable). Behaviour is tuned via Agent:FakeTools:* (picked up on the next job).
{
  "id": "fake",
  "displayName": "Fake scanner (synthetic, no network traffic)",
  "version": "1.0.0",
  "maxConcurrency": 16,
  "defaultTimeoutSeconds": 600,
  "capabilities": {
    "host-discovery": { "adapter": "fake" },
    "port-scan": { "adapter": "fake" },
    "service-detection": { "adapter": "fake" },
    "http-probe": { "adapter": "fake" },
    "tls-probe": { "adapter": "fake" },
    "signature-scan": { "adapter": "fake" }
  }
}
