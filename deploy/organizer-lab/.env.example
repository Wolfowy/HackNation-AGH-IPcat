# Secrets of the lab instance (generate your own, e.g. `openssl rand -hex 24`).
POSTGRES_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me
JWT_SIGNING_KEY=change-me-at-least-32-characters-long-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
AGENT_ENROLLMENT_TOKEN=change-me-at-least-32-characters-long-token
ORGLAB_PANEL_PORT=9088

# Organizer stack "custom-network": its two Docker networks and their subnets (docker network inspect <name>).
LAB_NET_A=hacknation-custom-network_frontend
LAB_NET_B=hacknation-custom-network_backend
LAB_SCOPE=172.25.0.0/16,172.24.0.0/16
