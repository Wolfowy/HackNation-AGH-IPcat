# Copy to deploy/docker/.env and change every secret. Never commit .env.
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432
RABBITMQ_USER=webscan
RABBITMQ_PASSWORD=change-me-rabbitmq

# HMAC key for user access tokens (at least 32 characters), e.g. `openssl rand -base64 48`
JWT_SIGNING_KEY=change-me-to-a-random-string-of-at-least-32-characters

# First administrator (created only while the user table is empty; password min. 12 characters)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Change-Me-Admin-1

# Enrollment token used by agent-1/agent-2 (auto-approved, authorized for zone "lab")
AGENT_ENROLLMENT_TOKEN=change-me-agent-enrollment-token

# Observability profile: set OTLP_ENDPOINT=http://otel-collector:4317 when running with --profile observability
OTLP_ENDPOINT=
GRAFANA_ADMIN_PASSWORD=change-me-grafana
# Read-only PostgreSQL role for Grafana (created on first database initialization only)
GRAFANA_DB_PASSWORD=change-me-grafana-ro

# Test lab compose file combined with -f resolves its paths against deploy/docker
TESTLAB_DIR=../../tests/TestLab
